# Copy to .env. Generate your own SECRET_KEY; never commit .env.
SECRET_KEY=
APP_ENV=development

# Google sign-in. Set a comma-separated list of authorized test accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
ALLOWED_GOOGLE_EMAILS=
PUBLIC_GOOGLE_SIGN_IN=false

GEMINI_API_KEY=

# Gmail delivery and reply tracking. OFFICIAL uses the verified USF directory.
SEND_MODE=TEST
GMAIL_REDIRECT_URI=http://localhost:5000/gmail/callback
GMAIL_TOKEN_KEY=
TEST_RECIPIENT=
